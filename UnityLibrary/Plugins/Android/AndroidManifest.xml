<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.intercom.unity">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required on Android 13+ to display push notifications. Request it at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <meta-data
            android:name="io.intercom.android.sdk.API_KEY"
            android:value="${INTERCOM_API_KEY}" />
        <meta-data
            android:name="io.intercom.android.sdk.APP_ID"
            android:value="${INTERCOM_APP_ID}" />
    </application>
</manifest> 